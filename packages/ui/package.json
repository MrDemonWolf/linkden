{
	"name": "@linkden/ui",
	"type": "module",
	"scripts": {
		"check-types": "tsc --noEmit"
	},
	"exports": {
		".": {
			"default": "./src/index.ts"
		},
		"./*": {
			"default": "./src/*.ts"
		},
		"./components/tabs": {
