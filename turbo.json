{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": ["dist/**", ".next/**", "!.next/cache/**"]
		},
		"lint": {
			"dependsOn": ["^lint"]
		},
		"check-types": {
			"dependsOn": ["^check-types"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"dev:bare": {
			"cache": false,
			"persistent": true
		},
		"dev:standalone": {
			"cache": false,
			"persistent": true
		},
		"db:push": {
			"cache": false
		},
		"db:generate": {
			"cache": false
		},
		"deploy": {
			"cache": false,
			"passThroughEnv": [
				"CLOUDFLARE_API_TOKEN",
				"CLOUDFLARE_ACCOUNT_ID",
				"ALCHEMY_PASSWORD",
				"ALCHEMY_STATE_TOKEN",
				"ALCHEMY_STAGE",
				"LINKDEN_DB_NAME",
				"LINKDEN_IMAGES_BUCKET",
				"SITE_DOMAIN",
				"BETTER_AUTH_SECRET",
				"BETTER_AUTH_URL",
				"NEXT_PUBLIC_SERVER_URL",
				"NEXT_PUBLIC_SITE_URL",
				"CORS_ORIGIN",
				"WALLET_SIGNER_CERT",
				"WALLET_SIGNER_KEY",
				"WALLET_WWDR_CERT",
				"WALLET_TEAM_ID",
				"WALLET_PASS_TYPE_ID"
			]
		},
		"destroy": {
			"cache": false,
			"passThroughEnv": [
				"CLOUDFLARE_API_TOKEN",
				"CLOUDFLARE_ACCOUNT_ID",
				"ALCHEMY_PASSWORD",
				"ALCHEMY_STATE_TOKEN",
				"ALCHEMY_STAGE",
				"LINKDEN_DB_NAME",
				"LINKDEN_IMAGES_BUCKET"
			]
		}
	}
}
