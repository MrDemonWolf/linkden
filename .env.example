# ===========================================
# LinkDen Environment Variables
# ===========================================
# Copy this file to .env and fill in the values.
# Only BETTER_AUTH_SECRET is strictly required to get started.

# ─── Required ────────────────────────────────────────────

# Auth secret — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-key-here

# Auth base URL (your Hono server)
BETTER_AUTH_URL=http://localhost:3000

# CORS origin (your Next.js frontend)
CORS_ORIGIN=http://localhost:3001

# Next.js public server URL (used by the browser)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Public site origin — used for robots.txt, sitemap, metadataBase and the PWA
# manifest. In production this is your custom domain (https://links.example.com).
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# ─── Optional: Cloudflare deploy (bun ship / CI) ─────────
# Only needed when deploying with Alchemy. CI reads these from repository
# secrets/variables; set them locally only if you deploy from your machine.

# Custom domain for the web worker (apex or subdomain in a zone on your
# account). The API worker gets Routes for <domain>/api/* and <domain>/trpc/*
# on the same hostname. Leave unset to stay on workers.dev.
# SITE_DOMAIN=links.example.com

# Encrypts secrets inside Alchemy state — generate with: openssl rand -base64 32
# ALCHEMY_PASSWORD=

# Auth token for the shared `alchemy-state` state-store worker.
# ALCHEMY_STATE_TOKEN=

# Alchemy stage (state namespace in the shared store). Defaults to "prod".
# ALCHEMY_STAGE=prod

# ─── Optional: Dev-only auth bypass ─────────────────────
# DEV_LOGIN="true" (exact string) registers a POST /api/auth/dev-login
# endpoint that signs you in without credentials; NEXT_PUBLIC_DEV_LOGIN="true"
# shows the matching button on /admin/login.
#
# Do NOT set DEV_LOGIN in this file (or any .env Alchemy loads) — it is
# deliberately not wired into the production deploy path. Set it only in
# apps/server/.dev.vars (gitignored, wrangler-dev-only) so it can never ship.
# NEXT_PUBLIC_DEV_LOGIN is safe here since it just toggles a UI button; the
# server independently 404s the endpoint unless .dev.vars enables it.

# NEXT_PUBLIC_DEV_LOGIN=true

# ─── Optional: Email (password reset, magic links) ──────

# EMAIL_PROVIDER=resend
# EMAIL_API_KEY=re_xxxxxxxxxxxxx
# EMAIL_FROM=noreply@yourdomain.com

# ─── Optional: CAPTCHA (contact form) ───────────────────

# CAPTCHA_PROVIDER=turnstile
# CAPTCHA_SITE_KEY=0x...
# CAPTCHA_SECRET_KEY=0x...

# ─── Optional: Apple Wallet Pass ────────────────────────

# WALLET_TEAM_ID=XXXXXXXXXX
# WALLET_PASS_TYPE_ID=pass.com.yourdomain.linkden
# WALLET_SIGNER_CERT=base64-encoded-cert
# WALLET_SIGNER_KEY=base64-encoded-key
# WALLET_WWDR_CERT=base64-encoded-wwdr-cert

# ─── Optional: MapKit (location blocks) ─────────────────

# MAPKIT_TOKEN=your-mapkit-jwt
