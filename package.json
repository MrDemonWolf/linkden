{
	"name": "linkden",
	"version": "0.5.0",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"@cloudflare/workers-types": "^4.20260702.1",
			"@tailwindcss/postcss": "^4.3.3",
			"@trpc/client": "^11.19.0",
			"@trpc/server": "^11.19.0",
			"@types/react": "^19.3.0",
			"@types/react-dom": "^19.3.0",
			"alchemy": "^0.93.12",
			"better-auth": "~1.6.33",
			"dotenv": "^17.4.2",
			"drizzle-orm": "^0.45.2",
			"hono": "^4.13.13",
			"lucide-react": "^1.52.0",
			"react": "^19.3.0",
			"react-dom": "^19.3.0",
			"tailwindcss": "^4.3.3",
			"typescript": "^6.0.3",
			"wrangler": "^4.148.0",
			"zod": "^4.6.5"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "turbo dev",
		"build": "turbo build",
		"check-types": "turbo check-types",
		"typecheck": "turbo check-types",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"dev:web": "turbo -F web dev:bare",
		"dev:server": "turbo -F server dev:standalone",
		"dev:docs": "turbo -F docs dev",
		"db:generate": "turbo -F @linkden/db db:generate",
		"deploy": "turbo -F @linkden/infra deploy",
		"ship": "turbo -F @linkden/infra deploy",
		"destroy": "turbo -F @linkden/infra destroy",
		"db:reset": "rm -rf .alchemy/miniflare apps/server/.wrangler/state && echo 'Local DB wiped (bun dev and bun dev:server stores). Restart bun dev to re-apply migrations; for bun dev:server apply them with wrangler d1 migrations apply / execute.'",
		"reset:password": "bun scripts/reset-password.ts",
		"reset:factory": "bun scripts/factory-reset.ts",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"test:e2e:headed": "playwright test --headed",
		"test:all": "vitest run && playwright test"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@cloudflare/workers-types": "catalog:",
		"@linkden/config": "workspace:*",
		"@playwright/test": "^1.63.0",
		"@testing-library/jest-dom": "^6.10.0",
		"@testing-library/react": "^16.3.3",
		"@types/node": "^25.9.9",
		"@vitejs/plugin-react": "^5.2.0",
		"@vitest/coverage-v8": "^4.1.11",
		"jsdom": "^28.1.0",
		"turbo": "^2.11.7",
		"typescript": "catalog:",
		"vitest": "^4.1.11"
	},
	"packageManager": "bun@1.3.14",
	"trustedDependencies": [
		"esbuild",
		"sharp",
		"workerd"
	],
	"overrides": {
		"compression": "^1.8.2",
		"drizzle-orm": "0.45.2",
		"mdast-util-to-markdown": "2.1.2",
		"undici": "^7.29.1",
		"vite": "^7.3.5",
		"ws": "^8.21.0"
	}
}
